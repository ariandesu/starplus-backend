{
  "name": "starplus-backend",
  "version": "1.0.0",
  "description": "STAR PLUS Backend \u2014 Cloudflare Workers API with D1 database",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply starplus-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply starplus-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  }
}
