{
  "name": "starplus-backend",
  "version": "1.0.0",
  "description": "STAR PLUS Backend — Cloudflare Workers API with D1 database",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "rehearse": "python ml/rehearse.py",
    "sync-core": "./tools/sync-core.sh",
    "d1:migrate:local": "wrangler d1 migrations apply starplus-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply starplus-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  }
}
