{
  "name": "starplus-backend",
  "version": "1.0.0",
  "description": "STAR PLUS Backend — Cloudflare Workers API with D1 database",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:execute": "wrangler d1 execute starplus-db --file=./schema.sql",
    "d1:create": "wrangler d1 create starplus-db",
    "d1:migrations": "wrangler d1 migrations apply starplus-db",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240801.0",
    "typescript": "^5.5.0",
    "vitest": "^1.0.0"
  }
}
